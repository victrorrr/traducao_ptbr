msgstr "Que chamativo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.ROBOT_PUPPET"
