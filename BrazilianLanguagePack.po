msgstr "Outra batalha perdida ao tempo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_MUD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TURF_MUD"
