msgstr "Talvez com isto, eu adie o inevitavel um pouco mais."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.TREASURECHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.TREASURECHEST"
